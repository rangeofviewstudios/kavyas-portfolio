# Environment Variables for Production

# Google Analytics
# Get your GA4 Measurement ID from https://analytics.google.com/
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Search Console Verification
# Get your verification code from https://search.google.com/search-console
# This should be added to app/layout.tsx metadata.verification.google
NEXT_PUBLIC_GOOGLE_VERIFICATION=your-google-site-verification-code
